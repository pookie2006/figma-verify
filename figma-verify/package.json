{
  "name": "figma-verify",
  "version": "0.1.0",
  "description": "MCP server that lets AI agents verify a live implementation against its Figma design and self-correct.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "figma-verify": "./dist/cli.js",
    "figma-verify-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "cli": "tsx src/cli.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:serve": "npx serve demo -l 4173",
    "demo:report": "tsx src/cli.ts --fixture demo/design-fixture.json \"file://$PWD/demo/index.html\" --html demo/report.html || true",
    "demo:open": "npm run demo:report --silent && node scripts/open-report.mjs demo/report.html"
  },
  "keywords": [
    "mcp",
    "figma",
    "design-verification",
    "playwright",
    "ai-agents"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "playwright": "^1.49.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
